{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=wrapper-crm.db"
  },
  "Jwt": {
    "Issuer": "WrapperCrm.Api",
    "Audience": "WrapperCrm.Frontend",
    "SigningKey": "change-this-before-production-use-a-long-random-secret-key",
    "ExpirationMinutes": 720
  },
  "GoogleAuth": {
    "AllowedAudience": ""
  },
  "GoogleAi": {
    "ApiKey": "",
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-3.1-flash-lite",
    "TimeoutSeconds": 30,
    "BatchSize": 40,
    "MaxSnippetsPerMetric": 300,
    "RetryCooldownSeconds": 120,
    "ThinkingBudget": 0
  },
  "AdminSeed": {
    "Email": "",
    "DisplayName": "VIP Admin",
    "PreferredLanguage": "es"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
